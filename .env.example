# ==============================================================================
# Our Story Book — كتاب قصتنا
# Environment Variables Example (.env.example)
#
# انسخ هذا الملف إلى .env.local وقم بتعبئة القيم من لوحة تحكم Supabase
# لا تقم برفع ملف .env.local أو أي مفاتيح حقيقية إلى GitHub مطلقًا!
# ==============================================================================

# 1. رابط مشروع Supabase (من Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. المفتاح العام المجهول (من Settings -> API -> anon public key)
# هذا المفتاح آمن للاستخدام في المتصفح لأن سياسات RLS تحمي البيانات بالكامل
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
